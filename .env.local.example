# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend). Without RESEND_API_KEY emails are logged and recorded as "skipped".
# RESEND_API_KEY=re_your-api-key
# EMAIL_FROM="FairSplit <onboarding@resend.dev>"
# Public base URL used for links in emails (falls back to VERCEL_PROJECT_PRODUCTION_URL, then localhost)
# NEXT_PUBLIC_APP_URL=https://fairsplit-hymavar.vercel.app

# Vercel Cron: /api/cron/reminders requires "Authorization: Bearer $CRON_SECRET" (Vercel sends it automatically)
# CRON_SECRET=a-long-random-string

# Anthropic / Claude API (Phase 2 - PDF parsing)
# ANTHROPIC_API_KEY=sk-ant-your-api-key

# Stripe (Phase 3)
# STRIPE_SECRET_KEY=sk_test_your-key
# STRIPE_WEBHOOK_SECRET=whsec_your-secret
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# Seed script (scripts/seed-users.ts) - admin account
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me
